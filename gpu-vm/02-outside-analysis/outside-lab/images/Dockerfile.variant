FROM python:3.11.11-slim-bookworm
ARG TORCH_VERSION
ARG TORCH_INDEX
RUN python -m pip install --no-cache-dir --index-url ${TORCH_INDEX} torch==${TORCH_VERSION} \
 && python -m pip install --no-cache-dir numpy==2.2.2 transformers==4.52.4 accelerate==1.4.0 \
    nvidia-ml-py==12.570.86 Pillow==11.1.0 safetensors==0.8.0 tokenizers==0.21.4 \
 && python -m pip freeze > /opt/environment.lock.txt
ENV HF_HOME=/cache/huggingface TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1
WORKDIR /work
