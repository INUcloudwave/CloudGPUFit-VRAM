# S4: python slim + torch 2.8.0+cu128, other packages pinned as S0
FROM python@sha256:081075da77b2b55c23c088251026fb69a7b2bf92471e491ff5fd75c192fd38e5
RUN python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu128 --extra-index-url https://pypi.org/simple \
    torch==2.8.0+cu128 numpy==2.2.2 transformers==4.52.4 accelerate==1.4.0 nvidia-ml-py==12.570.86 Pillow==11.1.0 safetensors==0.8.0 tokenizers==0.21.4 \
 && python -m pip freeze > /opt/environment.lock.txt
ENV HF_HOME=/cache/huggingface TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1
WORKDIR /work
