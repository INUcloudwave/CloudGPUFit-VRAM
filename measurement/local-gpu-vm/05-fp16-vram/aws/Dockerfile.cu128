# cloudgpufit-bench:cu128-v1 (2026-11-17) - for Blackwell (sm_120, e.g. AWS g7 RTX PRO 4500) which cu124-v1 cannot run.
# Same as ../Dockerfile.benchmark except: base torch 2.6.0+cu124 -> 2.7.1+cu128 (pinned by digest), and every package that
# the cu124-v1 pip step added is pinned to the exact version that cu124-v1 resolved (/opt/environment.lock.txt there).
FROM pytorch/pytorch@sha256:c16f4c749e2d9e96878875cdf6cc45cddda1d1a36fddd371dd6f2360f1b6e2a2
RUN python -m pip install --no-cache-dir \
    transformers==4.52.4 \
    accelerate==1.4.0 \
    nvidia-ml-py==12.570.86 \
    Pillow==11.1.0 \
    huggingface_hub==0.36.2 \
    hf-xet==1.6.0 \
    regex==2026.9.29 \
    safetensors==0.8.0 \
    tokenizers==0.21.4 \
    && python -m pip freeze > /opt/environment.lock.txt
ENV HF_HOME=/cache/huggingface
ENV TOKENIZERS_PARALLELISM=false
ENV PYTHONUNBUFFERED=1
WORKDIR /work
