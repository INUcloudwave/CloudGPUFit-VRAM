# S0-equivalent: same recipe as cloudgpufit-bench:cu124-v1 (base pinned by digest)
FROM pytorch/pytorch@sha256:77f17f843507062875ce8be2a6f76aa6aa3df7f9ef1e31d9d7432f4b0f563dee
RUN python -m pip install --no-cache-dir transformers==4.52.4 accelerate==1.4.0 nvidia-ml-py==12.570.86 Pillow==11.1.0 \
 && python -m pip freeze > /opt/environment.lock.txt
ENV HF_HOME=/cache/huggingface TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1
WORKDIR /work
